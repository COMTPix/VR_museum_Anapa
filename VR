            document.querySelector('.loader').style.display = 'none';
        }, 5000);

        function enterMuseum() {
            loadingScreen.classList.add('fade-out');
            setTimeout(() => {
                loadingScreen.style.display = 'none';
            }, 1000);

            // Request pointer lock for better controls
            const canvas = scene.canvas;
            if (canvas) {
                canvas.addEventListener('click', () => {
                    canvas.requestPointerLock();
                });
            }
        }

        // Ambient sound simulation with footstep feedback
        let lastPos = { x: 0, z: 0 };
        
        // Particle dust effect (floating particles in the museum)
        AFRAME.registerComponent('dust-particles', {
            init: function () {
                for (let i = 0; i < 50; i++) {
                    const particle = document.createElement('a-sphere');
                    particle.setAttribute('radius', Math.random() * 0.02 + 0.005);
                    particle.setAttribute('position', {
                        x: (Math.random() - 0.5) * 28,
                        y: Math.random() * 7 + 0.5,
                        z: (Math.random() - 0.5) * 48
                    });
                    particle.setAttribute('material', {
                        color: '#FFF8E7',
                        opacity: Math.random() * 0.3 + 0.1,
                        transparent: true
                    });
                    particle.setAttribute('animation', {
                        property: 'position.y',
                        dir: 'alternate',
                        dur: Math.random() * 5000 + 3000,
                        easing: 'easeInOutSine',
                        loop: true,
                        to: Math.random() * 7 + 0.5
                    });
                    this.el.appendChild(particle);
                }
            }
        });

        // Add dust particles to scene
        const dustEntity = document.createElement('a-entity');
        dustEntity.setAttribute('dust-particles', '');
        scene.appendChild(dustEntity);

        // Hide info panel after 8 seconds
        setTimeout(() => {
            const infoPanel = document.getElementById('info-panel');
            infoPanel.style.transition = 'opacity 2s';
            infoPanel.style.opacity = '0';
            setTimeout(() => { infoPanel.style.display = 'none'; }, 2000);
        }, 8000);
    </script>
</body>
</html>
